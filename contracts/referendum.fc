#pragma version >=0.4.0;

#include "imports/stdlib.fc";

;; Storage TL-B:
;; storage#_ last_id:uint64 votes:(HashmapE 64 ^Cell) = Storage;

(int, cell) load_data() inline {
    slice ds = get_data().begin_parse();
    if (ds.slice_empty?()) {
        return (0, new_dict());
    }
    return (
        ds~load_uint(64),  ;; last_id
        ds~load_dict()     ;; votes dictionary
    );
}

() save_data(int last_id, cell votes_dict) impure inline {
    set_data(begin_cell()
        .store_uint(last_id, 64)
        .store_dict(votes_dict)
        .end_cell());
}

;; Get Methods
int get_last_id() method_id {
    (int last_id, _) = load_data();
    return last_id;
}

cell get_cell_by_id(int id) method_id {
    (_, cell votes_dict) = load_data();
    (cell value, int found?) = votes_dict.udict_get_ref?(64, id);
    throw_unless(404, found?);
    return value;
}

 slice get_cell_slice_by_id(int id) method_id {
    cell cell_value = get_cell_by_id(id);
    return cell_value.begin_parse();
}

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    (int last_id, cell votes_dict) = load_data();

    ;; Check for empty message body
    if (in_msg_body.slice_empty?()) {
        return ();
    }

    ;; Parse operation code
    int op = in_msg_body~load_uint(32);
    
    if (op == 1) {
        ;; Parse query_id
        int query_id = in_msg_body~load_uint(64);
        
        ;; Parse sender address from message
        slice cs = in_msg_full.begin_parse();
        cs~load_uint(4);  ;; Skip flags
        slice sender_addr = cs~load_msg_addr();
        
        ;; Extract full 256-bit sender hash for maximum security
        slice sender_copy = sender_addr;
        sender_copy~load_uint(2);  ;; Skip format
        sender_copy~load_uint(1);  ;; Skip anycast  
        sender_copy~load_uint(8);  ;; Skip workchain
        
        ;; Load all 8 chunks of 32-bit hash (total 256 bits)
        int hash1 = sender_copy~load_uint(32);
        int hash2 = sender_copy~load_uint(32);
        int hash3 = sender_copy~load_uint(32);
        int hash4 = sender_copy~load_uint(32);
        int hash5 = sender_copy~load_uint(32);
        int hash6 = sender_copy~load_uint(32);
        int hash7 = sender_copy~load_uint(32);
        int hash8 = sender_copy~load_uint(32);
        
        ;; Check full 256-bit authorization - ALL chunks must match YOUR MAINNET ADDRESS
        if ((hash1 == 1274189081) & 
            (hash2 == 4013625637) & 
            (hash3 == 3635670598) & 
            (hash4 == 215126534) & 
            (hash5 == 2858486672) & 
            (hash6 == 233832247) & 
            (hash7 == 3583925189) & 
            (hash8 == 2145809464)) {
            ;; Authorized user - save vote hash
            cell hash = in_msg_body~load_ref();
            last_id += 1;
            votes_dict~udict_set_ref(64, last_id, hash);
            save_data(last_id, votes_dict);
            
            ;; Send response with query_id and last_id
            cell response_body = begin_cell()
                .store_uint(0x12345678, 32)  ;; Response op code
                .store_uint(query_id, 64)    ;; Echo back query_id
                .store_uint(last_id, 64)     ;; Return last_id
                .end_cell();
                
            send_raw_message(begin_cell()
                .store_uint(0x10, 6)         ;; Internal message flags
                .store_slice(sender_addr)    ;; Destination (original sender)
                .store_coins(0)              ;; Value (0 TON)
                .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1) ;; Extra currencies + IHR fee + fwd fee + created_lt + created_at + no state_init + has body
                .store_ref(response_body)    ;; Response body as reference
                .end_cell(), 64);            ;; Mode 64: ignore errors
        }
        ;; Unauthorized users are silently ignored
        return ();
    }

    ;; Invalid operations are silently ignored
}